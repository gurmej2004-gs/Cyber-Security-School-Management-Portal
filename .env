# Environment Configuration for School Management System
# =====================================================

# Server Configuration
NODE_ENV=development
HTTP_PORT=3000
HTTPS_PORT=3443

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production-2025
JWT_EXPIRES_IN=1h

# Database Configuration
DB_PATH=./school.db
DB_BACKUP_PATH=./school_backup.db

# Encryption Configuration
ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# SSL Configuration
SSL_ENABLED=true
SSL_KEY_PATH=./key.pem
SSL_CERT_PATH=./cert.pem
SSL_REDIRECT_HTTP=false

# CORS Configuration (Development)
CORS_ORIGINS=https://localhost:3443,http://localhost:3000,https://127.0.0.1:3443,http://127.0.0.1:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Session Configuration
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production-2025
SESSION_TIMEOUT_ADMIN=3600000
SESSION_TIMEOUT_TEACHER=2700000
SESSION_TIMEOUT_STUDENT=1800000

# Anti-Phishing Configuration
ALLOWED_DOMAINS=localhost,127.0.0.1,localhost:3000,127.0.0.1:3000,localhost:3443,127.0.0.1:3443

# Notification Configuration
# Email Alerts
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=security@school.edu
ADMIN_EMAIL=admin@school.edu

# Slack Alerts
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#security-alerts
SLACK_USERNAME=School Security Bot

# Discord Alerts
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
DISCORD_USERNAME=School Security Bot

# Microsoft Teams Alerts
TEAMS_ALERTS_ENABLED=false
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# Production overrides (uncomment for production)
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SSL_REDIRECT_HTTP=true
# RATE_LIMIT_MAX_REQUESTS=50
